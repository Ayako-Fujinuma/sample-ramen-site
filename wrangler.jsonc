{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers name(デプロイ先のプロジェクト名)。使い回す場合は業種ごとに変更してください。
  "name": "sample-ramen-site",
  "compatibility_date": "2026-09-10",
  // Workers Static Assets: public/ 以下をそのまま配信します(Pages Functions等は使いません)
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // 独自ドメインに一本化。旧URL(*.workers.dev)は無効化している
  "workers_dev": false,
  "routes": [
    { "pattern": "sample-ramen.hirakuhp.com", "custom_domain": true }
  ]
}
